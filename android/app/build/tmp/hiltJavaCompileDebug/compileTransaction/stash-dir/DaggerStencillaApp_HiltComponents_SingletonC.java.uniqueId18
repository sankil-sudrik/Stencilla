          case 9: // com.stencilla.app.data.repository.WardrobeAnalyticsRepository 
          return (T) new WardrobeAnalyticsRepository(singletonCImpl.provideApiServiceProvider.get(), singletonCImpl.clothingItemDao(), singletonCImpl.outfitDao());

          case 10: // com.stencilla.app.data.repository.OutfitRepository 
          return (T) new OutfitRepository(singletonCImpl.provideApiServiceProvider.get(), singletonCImpl.outfitDao(), singletonCImpl.outfitFeedbackDao(), singletonCImpl.clothingItemDao());

